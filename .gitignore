# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Personal song library backups (copyrighted lyrics)
.backup-sample/

# Local server's Python environment
tools/.venv/

# Uploaded projection media (local server)
.media/
.songdb/
.backups/

# Local tools and editors
.claude/
tools/__pycache__/
**/__pycache__/
android/local.properties

# Desktop (Electron) build: dependencies, output, and the server's Python
# libraries and runtime, which each build installs (requirements.txt)
desktop/electron/node_modules/
desktop/electron/dist/
desktop/electron/pylib/
desktop/electron/python/*
!desktop/electron/python/.gitkeep

# Store and website work files (captures and the browser profile they use)
